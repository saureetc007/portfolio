# ==============================================================================
# SAUREET PORTFOLIO — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local testing, or set these in your
# Vercel / Netlify project settings for production email delivery.
# ==============================================================================

# Resend API Key (obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Sender email address
# Development (free tier without custom domain): onboarding@resend.dev
# Production (with verified custom domain): contact@yourdomain.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Target notification recipient address (verified fixed destination)
CONTACT_TO_EMAIL=saureetc007@gmail.com

